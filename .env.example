# Whisper model name (tiny, base, small, medium, large-v3, ...)
MODEL_NAME=base

# Execution device: cpu or cuda
DEVICE=cpu

# Compute type: int8, float16, float32, ... (use float16 with cuda)
COMPUTE_TYPE=int8

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of accepted file extensions
SUPPORTED_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg

# Host and port for the development server
HOST=0.0.0.0
PORT=8000
